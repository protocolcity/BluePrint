{
  "version": 1,
  "description": "City permissions SoT. Vendor settings are generated by policy_sync; host-personal overrides live only in .claude/settings.local.json.",
  "path_boundaries": {
    "respect_files": [
      "BOUNDARIES.md",
      "PERIMETER.md"
    ],
    "notes": "Host-private products must not import WorkLane runtime. Hands never commit across project boundaries under this identity."
  },
  "command_classes": {
    "allow": [
      "mcp__worklane",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(curl -s --max-time 5 http://127.0.0.1:8797:*)",
      "Bash(curl -s --max-time 5 http://127.0.0.1:8799:*)",
      "Bash(curl -s --max-time 5 http://localhost:8797:*)",
      "Bash(curl -s --max-time 5 http://localhost:8799:*)"
    ],
    "deny": [
      "Bash(git add -A:*)",
      "Bash(git add .)",
      "Bash(git commit -a:*)"
    ]
  },
  "hooks": [],
  "capability_tiers": {
    "default": "implement",
    "notes": "Per-seat tiers reserved for a future MCP gateway; Claude city settings are workspace-wide in v1."
  },
  "vendor_mirrors": {
    "claude": {
      "path": ".claude/settings.json",
      "format": "claude_settings_v1",
      "status": "active"
    },
    "codex": {
      "path": ".codex/config.toml",
      "format": "reserved",
      "status": "reserved"
    },
    "grok": {
      "path": ".grok/config.toml",
      "format": "reserved",
      "status": "reserved"
    }
  }
}
