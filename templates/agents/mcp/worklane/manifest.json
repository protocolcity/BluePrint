{
  "id": "worklane",
  "description": "WorkLane board (claim, close, ready)",
  "transport": "stdio",
  "command": "{{WORKSPACE_ROOT}}/worklane/.venv/bin/python",
  "args": [
    "-m",
    "worklane.mcp",
    "--author",
    "you"
  ],
  "env": {
    "TP_AGENT_ID": "${TP_AGENT_ID:-you}",
    "WORKLANE_RUNTIME_DIR": "{{WORKSPACE_ROOT}}/worklane/worklane/local"
  },
  "env_required": [],
  "capability": "mutating",
  "risk": "board write — claim/close/label; not money",
  "seats": [
    "*"
  ],
  "level": "L0",
  "vendor_locked": false,
  "enabled": true,
  "notes": "Author defaults to you; hands set TP_AGENT_ID at process start. Legacy vendor id ticketingprotocol is stripped on mcp_sync apply. Engine still dual-reads TICKETING_PROTOCOL_RUNTIME_DIR."
}
